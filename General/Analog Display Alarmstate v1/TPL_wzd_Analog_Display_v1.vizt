        <Group Name="Administrators" ConfigureAccess="true" ReadAccess="true" WiteAccess="true" RemoveAccess="true" />
        <User Name="Guest" ConfigureAccess="false" ReadAccess="true" WiteAccess="true" RemoveAccess="false" />
        <User Name="Adr_Admin" ConfigureAccess="true" ReadAccess="true" WiteAccess="true" RemoveAccess="true" />
        <Audit>true</Audit>
        <AuthorizationRequired>true</AuthorizationRequired>
      </Tag>
    </Security>
